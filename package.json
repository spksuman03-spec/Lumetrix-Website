{
  "name": "mern-ecommerce",
  "version": "1.0.0",
  "description": "Full-Stack MERN E-Commerce Application",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "server": "nodemon backend/server.js",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "data:import": "node backend/scripts/seeder.js -i",
    "data:destroy": "node backend/scripts/seeder.js -d"
  },
  "keywords": ["mern", "ecommerce", "react", "express", "node", "mongodb"],
  "author": "Antigravity AI",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0"
  }
}
